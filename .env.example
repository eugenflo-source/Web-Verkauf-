# ---------------------------------------------------------------------------
# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte in Vercel
# unter Project → Settings → Environment Variables ein.
# Variablen mit NEXT_PUBLIC_ sind im Browser sichtbar – dort NIE geheime
# Schlüssel eintragen.
# ---------------------------------------------------------------------------

# Öffentliche Adresse der Website (ohne Schrägstrich am Ende)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Erst auf "true" setzen, wenn alle Platzhalter und Rechtstexte ersetzt sind
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/Anon Key (öffentlich, durch Row Level Security geschützt)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret/Service Role Key – NUR serverseitig, niemals mit NEXT_PUBLIC_ versehen
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers → API keys) ----------------------------------------
# Leer lassen = simulierter Testablauf ohne Zahlung.
# sk_test_… = Stripe-Testmodus, sk_live_… = echte Zahlungen.
STRIPE_SECRET_KEY=
# Developers → Webhooks → Endpoint https://DEINE-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
